# Postgres connection string (Neon, Vercel Postgres, or local Postgres).
DATABASE_URL="postgresql://user:password@host:5432/osanebi?sslmode=require"

# Random secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Llama 3 via any OpenAI-compatible endpoint.
# Local dev default assumes Ollama running `ollama run llama3`:
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY=""
LLM_MODEL="llama3"

# For hosted inference instead, e.g. Groq:
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY="gsk_..."
# LLM_MODEL="llama3-70b-8192"

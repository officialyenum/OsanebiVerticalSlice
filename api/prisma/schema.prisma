// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

generator webClient {
  provider = "prisma-client"
  output   = "../../web/src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

// Osanebi — full domain model.
// This slice's UI/API only touches User, Studio, Game, Session, Feedback,
// and Report — everything else (Event, Task, PublisherInsight) is modeled
// now so the schema doesn't need to change shape later.

enum UserRole {
  admin
  publisher
  studio
  playtester
}

enum SessionStatus {
  scheduled
  live
  completed
}

enum EventType {
  gameplay
  bug
  reaction
  system
}

enum FeedbackCategory {
  bug
  ux
  balance
  narrative
  performance
}

enum FeedbackSeverity {
  low
  medium
  high
  critical
}

enum ReportType {
  qa_summary
  pitch_report
  publisher_brief
}

enum TaskPriority {
  P0
  P1
  P2
}

enum TaskStatus {
  open
  in_progress
  done
}

enum TaskSource {
  feedback
  ai_report
  manual
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole
  bio          String?
  skills       Json?
  studioName   String?  @map("studio_name")
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")

  ownedStudios     Studio[]            @relation("StudioOwner")
  studioMembership StudioMember[]
  sessionsAsTester SessionPlaytester[]
  feedbackAuthored Feedback[]

  @@map("users")
}

model Studio {
  id          String   @id @default(cuid())
  ownerUserId String   @map("owner_user_id")
  owner       User     @relation("StudioOwner", fields: [ownerUserId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  members StudioMember[]
  games   Game[]

  @@map("studios")
}

// Explicit join table so studio team membership can carry its own fields later.
model StudioMember {
  id       String @id @default(cuid())
  studioId String @map("studio_id")
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id])

  @@unique([studioId, userId])
  @@map("studio_members")
}

model Game {
  id           String   @id @default(cuid())
  studioId     String   @map("studio_id")
  studio       Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)
  title        String
  genre        String?
  platform     String?
  buildVersion String?  @map("build_version")
  buildBranch  String?  @map("build_branch")
  pitchSummary String?  @map("pitch_summary")
  createdAt    DateTime @default(now()) @map("created_at")

  sessions          Session[]
  tasks             Task[]
  publisherInsights PublisherInsight[]

  @@map("games")
}

model Session {
  id        String        @id @default(cuid())
  gameId    String        @map("game_id")
  game      Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status    SessionStatus @default(scheduled)
  startTime DateTime?     @map("start_time")
  endTime   DateTime?     @map("end_time")
  notes     String?
  createdAt DateTime      @default(now()) @map("created_at")

  playtesters SessionPlaytester[]
  events      Event[]
  feedback    Feedback[]
  reports     Report[]
  tasks       Task[]

  @@map("sessions")
}

model SessionPlaytester {
  id        String  @id @default(cuid())
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String  @map("user_id")
  user      User    @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@map("session_playtesters")
}

model Event {
  id        String    @id @default(cuid())
  sessionId String    @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      EventType
  timestamp DateTime  @default(now())
  payload   Json

  @@index([sessionId, timestamp])
  @@map("events")
}

model Feedback {
  id           String           @id @default(cuid())
  sessionId    String           @map("session_id")
  session      Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorUserId String           @map("author_user_id")
  author       User             @relation(fields: [authorUserId], references: [id])
  category     FeedbackCategory
  severity     FeedbackSeverity
  content      String
  tags         Json?
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("feedback")
}

model Report {
  id        String     @id @default(cuid())
  sessionId String     @map("session_id")
  session   Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      ReportType
  content   String
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("reports")
}

model Task {
  id          String       @id @default(cuid())
  gameId      String?      @map("game_id")
  game        Game?        @relation(fields: [gameId], references: [id])
  sessionId   String?      @map("session_id")
  session     Session?     @relation(fields: [sessionId], references: [id])
  title       String
  description String?
  priority    TaskPriority
  status      TaskStatus   @default(open)
  source      TaskSource
  createdAt   DateTime     @default(now())

  @@map("tasks")
}

model PublisherInsight {
  id                   String   @id @default(cuid())
  gameId               String   @map("game_id")
  game                 Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  score                Int
  rationale            String
  recommendedNextSteps String   @map("recommended_next_steps")
  createdAt            DateTime @default(now())

  @@map("publisher_insights")
}

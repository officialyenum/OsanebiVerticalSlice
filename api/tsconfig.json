{
  "compilerOptions": {
    "typeRoots": [
      "./node_modules/@types",
      "./types"
    ],
    "types": [
      "node"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "paths": {
      "@api/*": [
        "./src/*",
        "./lib/*",
        "./prisma/*"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
}
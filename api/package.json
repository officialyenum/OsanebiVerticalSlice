{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "prisma:generate": "prisma generate",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply osanebi --local",
    "db:migrate:remote": "wrangler d1 migrations apply osanebi --remote",
    "db:seed:local": "wrangler d1 execute osanebi --local --file=prisma/seed.sql",
    "db:seed:remote": "wrangler d1 execute osanebi --remote --file=prisma/seed.sql",
    "db:seed:cloudflare": "wrangler d1 execute osanebi --remote --file=prisma/seed.sql",
    "db:setup:local": "pnpm db:migrate:local && pnpm db:seed:local",
    "db:setup:remote": "pnpm db:migrate:remote && pnpm db:seed:remote",
    "db:reset:local": "pnpm db:seed:local",
    "db:reset:remote": "pnpm db:seed:remote",
    "seed": "pnpm db:seed:cloudflare"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.2",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.5",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/node": "^26.4.1",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "wrangler": "^4.128.0"
  }
}